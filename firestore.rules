rules_version = '2';

// ═══════════════════════════════════════════════════════════════
// คอร์สออนไลน์ KP Science — Firestore Security Rules (4 บทบาท)
// โปรเจกต์ Firebase ของเว็บคอร์ส (แยกจาก kp-science-f11ff ของเว็บ simulation)
// วาง/Publish ใน Console: Firestore → Rules  (หรือ firebase deploy --only firestore:rules --project kp-course)
//
// บทบาท
//   แอดมิน   = Google ของ komanepapato@gmail.com (email_verified) — ทำได้ทุกอย่าง
//   ครู      = มีเอกสาร /staff/{อีเมล} ที่ active == true + ล็อกอิน Google (email_verified) — จัดการเฉพาะคอร์สที่ owner = อีเมลตัวเอง
//   นักเรียน = ล็อกอินแล้ว — เรียนคอร์สที่มี /enrollments/{uid}_{cid}
//   ผู้เยี่ยมชม = ยังไม่ล็อกอิน — เห็นคอร์สที่เผยแพร่ + บทฟรี
//
//   /staff/{email}                  — รายชื่อครู (แอดมินเขียน)
//   /students/{uid}                 — บัญชีนักเรียน (courses[] = ระบบเดิม ใช้ได้แต่ไม่เขียนใหม่)
//   /courses/{cid}                  — ข้อมูลคอร์ส + สารบัญ + owner (อีเมลครูเจ้าของ)
//   /courses/{cid}/lessons/{lid}    — เนื้อหาบท
//   /enrollments/{uid}_{cid}        — สิทธิ์เข้าเรียน (ครูเจ้าของคอร์ส/แอดมินสร้าง)
//   /course_progress/{uid}_{cid}    — ความคืบหน้า (นักเรียนเขียนของตัวเอง)
//   /course_requests/{uid}_{cid}    — คำขอสิทธิ์ / แจ้งชำระเงิน (นักเรียนสร้าง · ครูตรวจยอดแล้วอนุมัติ)
//   /courses/{cid}/announcements/{id} — ประกาศของคอร์ส (ครูเจ้าของเขียน · คนมีสิทธิ์เรียนอ่าน)
//   /courses/{cid}/meta/pay         — ข้อมูลรับเงิน (อ่านได้เมื่อล็อกอิน)
//   /course_rejections/{uid}_{cid}  — เหตุผลที่ไม่อนุมัติคำขอ (ครูเขียน · นักเรียนเจ้าของอ่าน/ลบเมื่อส่งใหม่)
//   /course_threads/{uid}_{cid}     — ข้อความนักเรียนถึงครู (+ /messages/{id}) เห็นเฉพาะนักเรียนเจ้าของ/ครูเจ้าของคอร์ส/แอดมิน
//   /support_threads/{uid}          — ข้อความนักเรียนถึงแอดมิน (+ /messages/{id}) เห็นเฉพาะเจ้าของและแอดมิน
//   /course_invites/{code}          — โค้ดเชิญ (ครูสร้าง · ใช้ได้ครั้งเดียว · อ่านได้เมื่อรู้โค้ด แต่ค้นรายการไม่ได้)
//   /course_revoked/{uid}_{cid}     — รายชื่อที่ถูกถอนสิทธิ์ + เหตุผล (ครูเขียน/ลบ · นักเรียนเจ้าของอ่านอย่างเดียว · ไม่ให้สิทธิ์เรียน)
//   /course_slips/{uid}_{cid}       — รูปสลิปการโอน (JPEG ย่อแล้วเก็บเป็นข้อความ · เห็นเฉพาะเจ้าของ/ครูเจ้าของคอร์ส/แอดมิน)
//   enrollments / progress / requests เก็บ owner ของคอร์สไว้ด้วย → ครูค้นด้วย where('owner','==',อีเมลตัวเอง)
// ═══════════════════════════════════════════════════════════════

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function myEmail() { return request.auth.token.get('email', ''); }
    function verified() { return signedIn() && request.auth.token.get('email_verified', false) == true && myEmail() != ''; }
    function isAdmin() { return verified() && myEmail() == 'komanepapato@gmail.com'; }
    function staffPath() { return /databases/$(database)/documents/staff/$(myEmail()); }
    function isTeacher() { return verified() && exists(staffPath()) && get(staffPath()).data.active == true; }

    function courseDoc(cid) { return get(/databases/$(database)/documents/courses/$(cid)).data; }
    function ownerOf(cid) { return courseDoc(cid).get('owner', ''); }
    // จัดการคอร์สนี้ได้ (แอดมิน หรือครูเจ้าของ)
    function ownsCourse(cid) { return isAdmin() || (isTeacher() && ownerOf(cid) == myEmail()); }
    function enrolled(cid) {
      return signedIn() && exists(/databases/$(database)/documents/enrollments/$(request.auth.uid + '_' + cid));
    }
    // ระบบเดิม: students/{uid}.courses
    function legacyCourse(cid) {
      return signedIn()
        && exists(/databases/$(database)/documents/students/$(request.auth.uid))
        && get(/databases/$(database)/documents/students/$(request.auth.uid)).data.get('courses', []).hasAny([cid, '*']);
    }
    function hasCourse(cid) { return ownsCourse(cid) || enrolled(cid) || legacyCourse(cid); }
    // ครูที่เป็นเจ้าของ (ใช้กับ enrollments / progress / requests ที่เก็บ owner)
    function teacherOwns(data) { return isTeacher() && data.get('owner', '') == myEmail(); }
    function isMine(data) { return signedIn() && data.get('uid', '') == request.auth.uid; }

    // ── ครู ─────────────────────────────────────
    match /staff/{email} {
      allow get: if isAdmin() || (verified() && myEmail() == email);
      allow list: if isAdmin();
      allow write: if isAdmin();
    }

    // ── นักเรียน ─────────────────────────────────
    match /students/{uid} {
      allow get: if isAdmin() || (signedIn() && request.auth.uid == uid);
      // ครูค้นนักเรียนด้วยอีเมลได้ทีละคน (ให้สิทธิ์ด้วยอีเมล)
      allow list: if isAdmin() || (isTeacher() && request.query.limit <= 1);
      allow create: if isAdmin() || (signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['email', 'name', 'courses', 'createdAt'])
        && request.resource.data.email == myEmail()
        && request.resource.data.courses is list
        && request.resource.data.courses.size() == 0);
      allow update: if isAdmin() || (signedIn() && request.auth.uid == uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name']));
      allow delete: if isAdmin();
    }

    // ── คอร์ส + บทเรียน ──────────────────────────
    match /courses/{cid} {
      allow read: if resource.data.published == true || isAdmin()
        || (isTeacher() && resource.data.get('owner', '') == myEmail());
      allow create: if isAdmin() || (isTeacher() && request.resource.data.owner == myEmail());
      // ครูโอนคอร์สให้คนอื่นเองไม่ได้ (เฉพาะแอดมิน)
      allow update: if isAdmin() || (isTeacher()
        && resource.data.get('owner', '') == myEmail()
        && request.resource.data.get('owner', '') == myEmail());
      allow delete: if isAdmin() || (isTeacher() && resource.data.get('owner', '') == myEmail());

      match /lessons/{lid} {
        allow read: if hasCourse(cid)
          || (resource.data.free == true && courseDoc(cid).published == true);
        allow write: if ownsCourse(cid);
      }

      match /announcements/{aid} {
        allow read: if hasCourse(cid);
        allow create: if ownsCourse(cid)
          && request.resource.data.keys().hasOnly(['text', 'by', 'createdAt'])
          && request.resource.data.by == request.auth.uid
          && request.resource.data.text is string
          && request.resource.data.text.size() >= 1 && request.resource.data.text.size() <= 2000;
        allow delete: if ownsCourse(cid);
      }

      // ข้อมูลรับเงิน (พร้อมเพย์) — ให้เห็นเฉพาะคนที่ล็อกอิน ไม่ให้ผู้เยี่ยมชม/บอตเห็นเบอร์ครู
      match /meta/{doc} {
        allow read: if signedIn() && (ownsCourse(cid) || courseDoc(cid).published == true);
        allow write: if ownsCourse(cid);
      }
    }

    // นักเรียนให้สิทธิ์ตัวเองด้วยโค้ดเชิญ: โค้ดต้องยังไม่ถูกใช้ก่อนเขียน และถูกผูกกับบัญชีนี้ในชุดคำสั่งเดียวกัน
    // (ตรวจสถานะก่อนเขียนด้วย get เพื่อไม่ให้ใช้โค้ดเดิมซ้ำหลังถูกถอนสิทธิ์)
    function invitePath(code) { return /databases/$(database)/documents/course_invites/$(code); }
    function redeemingInvite(eid) {
      let d = request.resource.data;
      return signedIn()
        && eid == request.auth.uid + '_' + d.courseId
        && d.uid == request.auth.uid
        && d.keys().hasOnly(['uid', 'email', 'name', 'courseId', 'owner', 'by', 'code', 'createdAt'])
        && d.email == myEmail()
        && d.by == 'invite'
        && d.name is string
        && d.name.size() <= 200
        && d.owner == ownerOf(d.courseId)
        && get(invitePath(d.code)).data.usedBy == ''
        && get(invitePath(d.code)).data.courseId == d.courseId
        && getAfter(invitePath(d.code)).data.usedBy == request.auth.uid;
    }

    // สมัครเองในคอร์สที่ครูเปิด “สมัครแล้วเรียนได้ทันที”: ต้องฟรีและเผยแพร่แล้ว · คนที่ถูกถอนสิทธิ์สมัครเองซ้ำไม่ได้
    function joiningOpenCourse(eid) {
      let d = request.resource.data;
      let c = courseDoc(d.courseId);
      return signedIn()
        && eid == request.auth.uid + '_' + d.courseId
        && d.uid == request.auth.uid
        && d.keys().hasOnly(['uid', 'email', 'name', 'courseId', 'owner', 'by', 'createdAt'])
        && d.email == myEmail()
        && d.by == 'open'
        && d.name is string
        && d.name.size() <= 200
        && d.owner == c.get('owner', '')
        && c.get('published', false) == true
        && c.get('openEnroll', false) == true
        && c.get('price', 0) == 0
        && !exists(/databases/$(database)/documents/course_revoked/$(eid));
    }

    // ── สิทธิ์เข้าเรียน: id = <uid>_<courseId> ─────
    match /enrollments/{eid} {
      allow read: if isAdmin() || isMine(resource.data) || teacherOwns(resource.data);
      allow create: if (ownsCourse(request.resource.data.courseId)
        && eid == request.resource.data.uid + '_' + request.resource.data.courseId
        && request.resource.data.keys().hasOnly(['uid', 'email', 'name', 'courseId', 'owner', 'by', 'contact', 'createdAt'])
        && request.resource.data.get('contact', '') is string
        && request.resource.data.get('contact', '').size() <= 100
        && request.resource.data.owner == ownerOf(request.resource.data.courseId))
        || redeemingInvite(eid)
        || joiningOpenCourse(eid);
      allow update: if isAdmin();
      allow delete: if isAdmin() || teacherOwns(resource.data);
    }

    // ── ความคืบหน้า: id = <uid>_<courseId> ─────────
    match /course_progress/{pid} {
      allow read: if isAdmin() || isMine(resource.data) || teacherOwns(resource.data);
      allow create, update: if isAdmin() || (signedIn()
        && pid == request.auth.uid + '_' + request.resource.data.courseId
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.keys().hasOnly(['uid', 'email', 'courseId', 'owner', 'done', 'total',
                                                 'last', 'lastAt', 'updatedAt'])
        && request.resource.data.done is list
        && request.resource.data.done.size() <= 500
        && request.resource.data.owner == ownerOf(request.resource.data.courseId)
        && hasCourse(request.resource.data.courseId));
      allow delete: if isAdmin() || teacherOwns(resource.data);
    }

    // ── คำขอสิทธิ์: id = <uid>_<courseId> ─────────
    match /course_requests/{rid} {
      allow read: if isAdmin() || isMine(resource.data) || teacherOwns(resource.data);
      allow create: if signedIn()
        && rid == request.auth.uid + '_' + request.resource.data.courseId
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.keys().hasOnly(['uid', 'email', 'name', 'courseId', 'owner', 'note', 'contact', 'amount', 'payRef', 'createdAt'])
        && request.resource.data.get('contact', '') is string
        && request.resource.data.get('contact', '').size() <= 100
        && request.resource.data.get('note', '').size() <= 300
        && request.resource.data.get('payRef', '').size() <= 100
        && request.resource.data.get('amount', 0) is number
        && courseDoc(request.resource.data.courseId).published == true
        && request.resource.data.owner == ownerOf(request.resource.data.courseId);
      allow update: if isAdmin();
      allow delete: if isAdmin() || isMine(resource.data) || teacherOwns(resource.data);
    }

    // ── สลิปการโอน: id = <uid>_<courseId> ─────────
    // นักเรียนแก้/ลบได้เฉพาะตอนคำขอยังรออยู่ — อนุมัติแล้วเป็นหลักฐาน แก้ไม่ได้
    function validSlip(rid) {
      let d = request.resource.data;
      return signedIn()
        && rid == request.auth.uid + '_' + d.courseId
        && d.uid == request.auth.uid
        && d.keys().hasOnly(['uid', 'courseId', 'owner', 'image', 'createdAt'])
        && d.image is string
        && d.image.size() <= 500000
        && d.image[0:23] == 'data:image/jpeg;base64,'
        && courseDoc(d.courseId).published == true
        && d.owner == ownerOf(d.courseId);
    }
    match /course_slips/{rid} {
      allow read: if isAdmin() || isMine(resource.data) || teacherOwns(resource.data);
      allow create: if validSlip(rid);
      allow update: if isAdmin() || (validSlip(rid)
        && existsAfter(/databases/$(database)/documents/course_requests/$(rid))
        && !enrolled(request.resource.data.courseId));
      allow delete: if isAdmin() || teacherOwns(resource.data)
        || (isMine(resource.data) && exists(/databases/$(database)/documents/course_requests/$(rid)));
    }

    // ── รายชื่อที่ถูกถอนสิทธิ์: id = <uid>_<courseId> ─────
    match /course_revoked/{rid} {
      allow read: if isAdmin() || isMine(resource.data) || teacherOwns(resource.data);
      allow create, update: if isAdmin() || (ownsCourse(request.resource.data.courseId)
        && rid == request.resource.data.uid + '_' + request.resource.data.courseId
        && request.resource.data.keys().hasOnly(['uid', 'email', 'name', 'contact', 'courseId', 'owner', 'reason', 'by', 'createdAt'])
        && request.resource.data.reason is string
        && request.resource.data.reason.size() <= 200
        && request.resource.data.get('contact', '') is string
        && request.resource.data.get('contact', '').size() <= 100
        && request.resource.data.owner == ownerOf(request.resource.data.courseId));
      // นักเรียนลบรายการของตัวเองได้เมื่อกลับมามีสิทธิ์แล้ว (ใช้โค้ดเชิญใหม่)
      allow delete: if isAdmin() || teacherOwns(resource.data)
        || (isMine(resource.data) && exists(/databases/$(database)/documents/enrollments/$(rid)));
    }

    // ── ข้อความนักเรียน ↔ ครู: id = <uid>_<courseId> ─────
    function threadKeysOk() {
      let d = request.resource.data;
      return d.lastText is string && d.lastText.size() <= 120
        && d.lastBy in ['student', 'teacher', 'admin']
        && d.unreadTeacher is bool && d.unreadStudent is bool;
    }
    match /course_threads/{tid} {
      allow read: if isAdmin() || isMine(resource.data) || teacherOwns(resource.data);
      // นักเรียนเริ่มถามได้เมื่อคอร์สเผยแพร่แล้ว หรือมีสิทธิ์อยู่แล้ว
      // ครูเจ้าของคอร์ส/แอดมินเริ่มห้องให้นักเรียนได้เช่นกัน
      allow create: if signedIn()
        && tid == request.resource.data.uid + '_' + request.resource.data.courseId
        && request.resource.data.keys().hasOnly(['uid', 'email', 'name', 'courseId', 'owner', 'lastAt', 'lastBy', 'lastText', 'unreadTeacher', 'unreadStudent'])
        && request.resource.data.email is string
        && request.resource.data.name is string && request.resource.data.name.size() <= 200
        && request.resource.data.owner == ownerOf(request.resource.data.courseId)
        && threadKeysOk()
        && (ownsCourse(request.resource.data.courseId)
          || (request.resource.data.uid == request.auth.uid
            && request.resource.data.email == myEmail()
            && (courseDoc(request.resource.data.courseId).published == true || hasCourse(request.resource.data.courseId))));
      allow update: if isAdmin() || ((isMine(resource.data) || teacherOwns(resource.data))
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'lastAt', 'lastBy', 'lastText', 'unreadTeacher', 'unreadStudent'])
        && request.resource.data.name is string && request.resource.data.name.size() <= 200
        && threadKeysOk());
      allow delete: if isAdmin() || teacherOwns(resource.data);

      function threadDoc() { return get(/databases/$(database)/documents/course_threads/$(tid)).data; }
      function threadAfter() { return getAfter(/databases/$(database)/documents/course_threads/$(tid)).data; }
      match /messages/{mid} {
        allow read: if isAdmin() || isMine(threadDoc()) || teacherOwns(threadDoc());
        allow create: if signedIn()
          && request.resource.data.keys().hasOnly(['from', 'by', 'text', 'lessonTitle', 'createdAt'])
          && request.resource.data.by == request.auth.uid
          && request.resource.data.text is string
          && request.resource.data.text.size() >= 1 && request.resource.data.text.size() <= 1000
          && request.resource.data.get('lessonTitle', '') is string
          && request.resource.data.get('lessonTitle', '').size() <= 200
          && ((request.resource.data.from == 'student' && isMine(threadAfter()))
            || (request.resource.data.from == 'teacher' && (isAdmin() || teacherOwns(threadAfter())))
            || (request.resource.data.from == 'admin' && isAdmin()));
        allow delete: if isAdmin() || teacherOwns(threadDoc());
      }
    }

    // ── ข้อความนักเรียน ↔ แอดมิน: id = uid ─────────
    match /support_threads/{uid} {
      function isOwnSupport() { return signedIn() && request.auth.uid == uid; }
      function supportOk() {
        let d = request.resource.data;
        return d.name is string && d.name.size() <= 200
          && d.lastText is string && d.lastText.size() <= 120
          && d.lastBy in ['student', 'admin']
          && d.unreadAdmin is bool && d.unreadStudent is bool;
      }
      allow read: if isAdmin() || isOwnSupport();
      allow create: if isOwnSupport()
        && request.resource.data.uid == uid
        && request.resource.data.email == myEmail()
        && request.resource.data.keys().hasOnly(['uid', 'email', 'name', 'lastAt', 'lastBy', 'lastText', 'unreadAdmin', 'unreadStudent'])
        && supportOk();
      allow update: if isAdmin() || (isOwnSupport()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'lastAt', 'lastBy', 'lastText', 'unreadAdmin', 'unreadStudent'])
        && supportOk());
      allow delete: if isAdmin();
      match /messages/{mid} {
        allow read: if isAdmin() || isOwnSupport();
        allow create: if signedIn()
          && request.resource.data.keys().hasOnly(['from', 'by', 'text', 'createdAt'])
          && request.resource.data.by == request.auth.uid
          && request.resource.data.text is string
          && request.resource.data.text.size() >= 1 && request.resource.data.text.size() <= 1000
          && ((request.resource.data.from == 'student' && isOwnSupport())
            || (request.resource.data.from == 'admin' && isAdmin()));
        allow delete: if isAdmin();
      }
    }

    // ── โค้ดเชิญ: id = ตัวโค้ด ─────────────────────
    match /course_invites/{code} {
      allow get: if signedIn();
      allow list: if isAdmin() || teacherOwns(resource.data);
      allow create: if ownsCourse(request.resource.data.courseId)
        && code.size() >= 10
        && request.resource.data.keys().hasOnly(['courseId', 'owner', 'email', 'usedBy', 'usedEmail', 'by', 'createdAt'])
        && request.resource.data.owner == ownerOf(request.resource.data.courseId)
        && request.resource.data.email is string
        && request.resource.data.email.size() <= 254
        && request.resource.data.usedBy == ''
        && request.resource.data.usedEmail == '';
      allow update: if isAdmin() || (signedIn()
        && resource.data.usedBy == ''
        && (resource.data.email == '' || resource.data.email == myEmail().lower())
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['usedBy', 'usedEmail', 'usedAt'])
        && request.resource.data.usedBy == request.auth.uid
        && request.resource.data.usedEmail == myEmail()
        && existsAfter(/databases/$(database)/documents/enrollments/$(request.auth.uid + '_' + resource.data.courseId)));
      allow delete: if isAdmin() || teacherOwns(resource.data);
    }

    // ── คำขอที่ไม่ผ่าน: id = <uid>_<courseId> ─────
    match /course_rejections/{rid} {
      allow read, delete: if isAdmin() || isMine(resource.data) || teacherOwns(resource.data);
      allow create, update: if isAdmin() || (ownsCourse(request.resource.data.courseId)
        && rid == request.resource.data.uid + '_' + request.resource.data.courseId
        && request.resource.data.keys().hasOnly(['uid', 'email', 'courseId', 'owner', 'reason', 'by', 'createdAt'])
        && request.resource.data.reason is string
        && request.resource.data.reason.size() <= 200
        && request.resource.data.owner == ownerOf(request.resource.data.courseId));
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
