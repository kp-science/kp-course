{
  "name": "kp-course-tests",
  "private": true,
  "type": "module",
  "scripts": {
    "test:rules": "RULES_FILE=../firestore.rules firebase emulators:exec --only firestore --project kp-course-test --config ../firebase.json \"node --test rules.test.mjs\"",
    "emu": "firebase emulators:start --only firestore,auth --project demo-kp-course --config ../firebase.json",
    "seed": "node seed-emulator.mjs ../prototype/courses.js"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^6.0.0",
    "firebase": "^13.0.0",
    "firebase-tools": "^15.33.0"
  }
}
